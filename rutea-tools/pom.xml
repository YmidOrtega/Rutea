<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>me.ymid.rutea</groupId>
    <artifactId>rutea-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>rutea-tools</artifactId>
  <name>Rutea :: Tools</name>
  <description>Extractores de datos, exportadores de instancias y mediciones de cada fase; nada de aquí entra a la app</description>

  <dependencies>
    <dependency>
      <groupId>me.ymid.rutea</groupId>
      <artifactId>rutea-app</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <skip>false</skip>
        </configuration>
        <executions>
          <execution>
            <id>baseline</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.planning.CompareBaseline</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f4-baseline</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>demo-plan</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.planning.DemoPlanExporter</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba-sitios-sensibles.csv</argument>
                <argument>${maven.multiModuleProjectDirectory}/web/public/demo/plan-suba.json</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>graphs</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.planning.CompareGraphs</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f7-bogota-graph</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>sensitive-sites</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.scenario.ExtractSensitiveSites</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/colombia-261019.osm.pbf</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba-sitios-sensibles.csv</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>bogota-sensitive-sites</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.scenario.ExtractSensitiveSites</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/colombia-261019.osm.pbf</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota-sitios-sensibles.csv</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>sectors</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.scenario.ExtractSectors</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/colombia-261019.osm.pbf</argument>
                <argument>${maven.multiModuleProjectDirectory}/rutea-app/src/main/resources/sectors</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>operator-containers</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.scenario.ExtractOperatorContainers</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/ase</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>suba-2026</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.planning.CompareSuba2026</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f7-suba-2026</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>door-to-door</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.planning.MeasureDoorToDoor</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f8-door-to-door</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>second-area</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.planning.PlanSecondArea</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/ase</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f7-second-area</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>city-plan</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.planning.MeasureCityPlan</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/ase</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota-sitios-sensibles.csv</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f7-city-plan</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>fleet</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.planning.MeasureFleet</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/ase</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f7-fleet</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>side-loading</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.scenario.CompareSideLoading</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/ase</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f7-side-loading</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>urban-perimeter</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.scenario.ExtractUrbanPerimeter</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/rutea-app/src/main/resources/localities/bogota-perimetro-urbano.geojson</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>localities</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.scenario.ExtractLocalities</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/colombia-261019.osm.pbf</argument>
                <argument>${maven.multiModuleProjectDirectory}/rutea-app/src/main/resources/localities/bogota-localidades.geojson</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>breakdowns</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.operations.BreakdownBenchmark</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f5-breakdowns</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>live-localities</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.planning.CheckLiveLocalities</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota-sitios-sensibles.csv</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/ase</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f8-live-localities</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>suba-live</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.planning.CompareSubaLive</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba-sitios-sensibles.csv</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota-sitios-sensibles.csv</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f8-suba-live</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>locality-breakdowns</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.operations.BreakdownBenchmark</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f8-breakdowns</argument>
                <argument>--locality</argument>
                <argument>11</argument>
                <argument>--slot</argument>
                <argument>LMVNoche</argument>
                <argument>--seed</argument>
                <argument>7</argument>
                <argument>--containers</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/ase</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>overflows</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.operations.OverflowBenchmark</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f5-overflows</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>closures</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.operations.ClosureBenchmark</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f5-closures</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>sensors</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.operations.SensorBenchmark</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f5-sensors</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>bogota-instances</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.scenario.ExportBogotaInstances</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/ase</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/bogota</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>locality-instances</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.scenario.ExportLocalityInstances</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/ase</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/bogota</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>suba-instance</id>
            <configuration>
              <mainClass>me.ymid.rutea.tools.scenario.ExportAreaInstance</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/suba</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
