<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>me.ymid.rutea</groupId>
    <artifactId>rutea-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>rutea-bench</artifactId>
  <name>Rutea :: Bench</name>
  <description>Comparación contra Timefold y microbenchmarks JMH; nada de aquí entra al solver</description>

  <dependencies>
    <dependency>
      <groupId>me.ymid.rutea</groupId>
      <artifactId>rutea-solver</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.timefold.solver</groupId>
      <artifactId>timefold-solver-core</artifactId>
      <version>${timefold.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
      <version>${jmh.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.openjdk.jmh</groupId>
              <artifactId>jmh-generator-annprocess</artifactId>
              <version>${jmh.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>compare</id>
            <configuration>
              <mainClass>me.ymid.rutea.bench.Compare</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/cvrplib/X</argument>
                <argument>--out</argument>
                <argument>${project.build.directory}/benchmarks</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <!-- JMH lanza JVMs aparte que necesitan el classpath en la línea de comandos: por eso exec y no java -->
            <id>jmh</id>
            <configuration>
              <executable>java</executable>
              <arguments>
                <argument>-Drutea.cvrplib.dir=${maven.multiModuleProjectDirectory}/data/cvrplib/X</argument>
                <argument>-classpath</argument>
                <classpath/>
                <argument>org.openjdk.jmh.Main</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <rutea.cvrplib.dir>${maven.multiModuleProjectDirectory}/data/cvrplib/X</rutea.cvrplib.dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
