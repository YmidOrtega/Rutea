<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>me.ymid.rutea</groupId>
    <artifactId>rutea-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>rutea-app</artifactId>
  <name>Rutea :: App</name>
  <description>Spring Boot: une dominio, solver y API</description>

  <dependencies>
    <dependency>
      <groupId>me.ymid.rutea</groupId>
      <artifactId>rutea-solver</artifactId>
    </dependency>
    <dependency>
      <groupId>me.ymid.rutea</groupId>
      <artifactId>rutea-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>me.ymid.rutea</groupId>
      <artifactId>rutea-geo</artifactId>
    </dependency>
    <dependency>
      <groupId>me.ymid.rutea</groupId>
      <artifactId>rutea-sim</artifactId>
    </dependency>
    <dependency>
      <groupId>me.ymid.rutea</groupId>
      <artifactId>rutea-geo</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>rutea-app</finalName>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>baseline</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.planning.CompareBaseline</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f4-baseline</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>sensitive-sites</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.scenario.ExtractSensitiveSites</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/colombia-261019.osm.pbf</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba-sitios-sensibles.csv</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>breakdowns</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.operations.BreakdownBenchmark</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f5-breakdowns</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>overflows</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.operations.OverflowBenchmark</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f5-overflows</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>closures</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.operations.ClosureBenchmark</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f5-closures</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>sensors</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.operations.SensorBenchmark</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f5-sensors</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>suba-instance</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.scenario.ExportSubaInstance</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/suba</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <!-- Sin spring-boot-starter-parent, repackage no se enlaza solo y el jar no sería ejecutable -->
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
