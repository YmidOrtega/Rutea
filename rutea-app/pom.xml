<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>me.ymid.rutea</groupId>
    <artifactId>rutea-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>rutea-app</artifactId>
  <name>Rutea :: App</name>
  <description>Spring Boot: une dominio, solver y API</description>

  <dependencies>
    <dependency>
      <groupId>me.ymid.rutea</groupId>
      <artifactId>rutea-solver</artifactId>
    </dependency>
    <dependency>
      <groupId>me.ymid.rutea</groupId>
      <artifactId>rutea-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>me.ymid.rutea</groupId>
      <artifactId>rutea-geo</artifactId>
    </dependency>
    <dependency>
      <groupId>me.ymid.rutea</groupId>
      <artifactId>rutea-sim</artifactId>
    </dependency>
    <dependency>
      <groupId>me.ymid.rutea</groupId>
      <artifactId>rutea-geo</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>rutea-app</finalName>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>baseline</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.planning.CompareBaseline</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f4-baseline</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>graphs</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.planning.CompareGraphs</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f7-bogota-graph</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>sensitive-sites</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.scenario.ExtractSensitiveSites</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/colombia-261019.osm.pbf</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba-sitios-sensibles.csv</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>bogota-sensitive-sites</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.scenario.ExtractSensitiveSites</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/colombia-261019.osm.pbf</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota-sitios-sensibles.csv</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>sectors</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.scenario.ExtractSectors</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/colombia-261019.osm.pbf</argument>
                <argument>${maven.multiModuleProjectDirectory}/rutea-app/src/main/resources/sectors</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>operator-containers</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.scenario.ExtractOperatorContainers</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/ase</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>suba-2026</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.planning.CompareSuba2026</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f7-suba-2026</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>door-to-door</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.planning.MeasureDoorToDoor</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f8-door-to-door</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>second-area</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.planning.PlanSecondArea</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/ase</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f7-second-area</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>city-plan</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.planning.MeasureCityPlan</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/ase</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota-sitios-sensibles.csv</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f7-city-plan</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>fleet</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.planning.MeasureFleet</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/ase</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f7-fleet</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>side-loading</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.scenario.CompareSideLoading</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/ase</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f7-side-loading</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>localities</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.scenario.ExtractLocalities</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/colombia-261019.osm.pbf</argument>
                <argument>${maven.multiModuleProjectDirectory}/rutea-app/src/main/resources/localities/bogota-localidades.geojson</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>breakdowns</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.operations.BreakdownBenchmark</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f5-breakdowns</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>overflows</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.operations.OverflowBenchmark</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f5-overflows</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>closures</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.operations.ClosureBenchmark</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f5-closures</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>sensors</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.operations.SensorBenchmark</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/docs/benchmarks/f5-sensors</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>bogota-instances</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.scenario.ExportBogotaInstances</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/ase</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/bogota</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>locality-instances</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.scenario.ExportLocalityInstances</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/bogota.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/ase</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/bogota</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>suba-instance</id>
            <configuration>
              <mainClass>me.ymid.rutea.app.scenario.ExportAreaInstance</mainClass>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/data/osm/suba.rgraph</argument>
                <argument>${maven.multiModuleProjectDirectory}/data/suba</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <!-- Sin spring-boot-starter-parent, repackage no se enlaza solo y el jar no sería ejecutable -->
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
